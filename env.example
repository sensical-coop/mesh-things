# --- Compose file selection ---
# REQUIRES USER ACTION: delete this line.
# Production should run the base file alone.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- Compose profile selection ---
# lite = minimal footprint.
# full = adds the Flink stream and the S3/Parquet archive writer.
# kafka-ui = the kafbat-ui topic browser, on top of either tier.
# minio = the bundled object store for the archive. Add it to full unless the
# archive lives on an external S3 (AWS or another provider): "full,minio".
# REQUIRES USER ACTION for full: set to "full,minio" or "full", or leave unset
# and pass --profile.
COMPOSE_PROFILES=lite

# --- App role ---
# "registry" or "readings"
APP_ROLE=registry

# --- MQTT settings ---
# REQUIRES USER ACTION
MQTT_BRIDGE__BROKER=''
MQTT_BRIDGE__PORT=8883
MQTT_BRIDGE__SSL=true
MQTT_BRIDGE__USER=""
MQTT_BRIDGE__PASS=""
# REQUIRES USER ACTION (the MQTT topic filter to subscribe to, e.g. 'msh/#'.)
MQTT_BRIDGE__TOPIC=''
MQTT_BRIDGE__SHARED_SUBS=true
# Members of one group get a share of the topic each
MQTT_BRIDGE__SHARED_GROUP=kafka-bridge
MQTT_BRIDGE__QOS=1
# compose/pipeline.yml sets MQTT_BRIDGE__CLIENT_ID per service. LEAVE IT BLANK
MQTT_BRIDGE__CLIENT_ID=
# Appended to both of the two above. LEAVE IT BLANK: docker-compose.dev.yml sets
# it to `dev` so a local stack doesn't take a share of production's messages.
MQTT_BRIDGE__INSTANCE_SUFFIX=
# How long the broker keeps a member's session after it disconnects (MQTT 5
# session expiry, seconds)
MQTT_BRIDGE__SESSION_EXPIRY=3600
MQTT_BRIDGE__RECONNECT=5
MQTT_BRIDGE__KAFKA_TOPIC="mesh.telemetry.raw.v1"
MQTT_BRIDGE__HEALTH__KAFKA_TOPIC="mesh.telemetry.rawhealth.v1"
MQTT_BRIDGE__HEALTH__TIMEOUT=5
MQTT_BRIDGE__HEALTH__PORT=9090
# Gateway discovery: this many new gateways per window are checked as soon as they
# are heard; once spent, a new gateway waits a full window. Each gateway is retried
# at most once per window. Per bridge member.
MQTT_BRIDGE__DISCOVERY__IMMEDIATE_GATEWAYS=50
MQTT_BRIDGE__DISCOVERY__DELAY_SECONDS=60

# --- EMQX connectors: MQTT sources and sinks ---
# Prefixes everything this instance creates on the EMQX that
# REGISTRY__EMQX_API_URL controls, so stacks sharing one broker stay apart:
# - sources: bridges named {namespace}-src-{source_id}, their traffic
#   republished on MQTT_BRIDGE__BROKER under {namespace}/{source_id}/..., which
#   the bridge subscribes to alongside MQTT_BRIDGE__TOPIC. MQTT_BRIDGE__BROKER
#   must therefore be that EMQX.
# - sinks: users named {namespace}-sink-{sink_id}, and topics under
#   {namespace}-sinks/{sink_id}/...
# Blank means `mt-sources`, which production uses; changing it on a running
# instance orphans what already exists on the broker. LEAVE IT BLANK:
# docker-compose.dev.yml sets `mt-sources-dev` so a local stack never touches
# production's bridges or sinks.
MQTT_CONNECTORS__NAMESPACE=

# --- MQTT sinks (third parties subscribe on this instance's EMQX) ---
# sink_dispatcher publishes each sink's readings on MQTT_BRIDGE__BROKER under
# {namespace}-sinks/{sink_id}/..., as this user, or as MQTT_BRIDGE__USER when
# blank. Registry lets only this user publish there and only each sink's own
# user subscribe, once the broker's built-in authorization database is first
# (manage.py sync_sinks --install-authz).
MQTT_SINKS__USER=
MQTT_SINKS__PASS=
# Where consumers connect, as host:port, shown with a sink's credentials.
# Blank uses MQTT_BRIDGE__BROKER:MQTT_BRIDGE__PORT. Best a listener of its own on EMQX,
# with tighter session limits than the bridge needs: meshtastic-things-mqtt runs one on
# 8884, e.g. mqtt.example.org:8884 (docs/deploy.md#mqtt-sinks).
REGISTRY__SINKS_BROKER=
# EMQX keeps an offline consumer's session and queues its messages by broker-wide limits
# (often weeks, and millions of messages). Each lifecycle pass discards a sink session
# offline longer than this many hours, or holding more queued messages than this, and
# disconnects a connected consumer that far behind. 0 turns either check off.
REGISTRY__SINKS_MAX_OFFLINE_HOURS=24
REGISTRY__SINKS_MAX_QUEUED=10000
# Each lifecycle pass emails an operator who opted in (status_alerts_enabled on their
# account), once per outage, when a source has not been connected for this many hours,
# or a sink with meshes or devices attached has had nobody connected for this long.
# 0 turns either alert off.
REGISTRY__SOURCE_ALERT_HOURS=2
REGISTRY__SINK_ALERT_HOURS=24
# Superusers, and the operator if they opted in, are emailed once when a source averages
# more messages per second than this over an hour. 0 turns it off.
REGISTRY__SOURCE_RATE_ALERT_MSGS_PER_S=20

# --- KAFKA settings ---
# Consumed by the apache/kafka image; don't rename them.
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_BOOTSTRAP_LOCAL=localhost:9092
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1
KAFKA_BROKER_ID=1
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP='CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT'
KAFKA_ADVERTISED_LISTENERS='PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092'
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_JMX_PORT=9997
KAFKA_JMX_OPTS=-Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false -Djava.rmi.server.hostname=kafka0 -Dcom.sun.management.jmxremote.rmi.port=9997
KAFKA_PROCESS_ROLES='broker,controller'
KAFKA_NODE_ID=1
KAFKA_CONTROLLER_QUORUM_VOTERS='1@kafka:29093'
KAFKA_LISTENERS='PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092'
KAFKA_INTER_BROKER_LISTENER_NAME='PLAINTEXT'
KAFKA_CONTROLLER_LISTENER_NAMES='CONTROLLER'
KAFKA_LOG_DIRS='/var/lib/kafka/data'
CLUSTER_ID='MkU3OEVBNTcwNTJENDM2Qk'

# --- PROTO DECODER settings ---
# KAFKA_TOPIC is the shared name for mesh.telemetry.decoded.v1
PROTO_DECODE__KAFKA_TOPIC="mesh.telemetry.decoded.v1"

# --- INFLUXDB settings ---
# REQUIRES USER ACTION: complete the setup wizard at
# http://localhost:8086 and fill *__TOKEN/ORG/BUCKET below
INFLUX__URL=http://influxdb:8086
INFLUX__URL_LOCAL=http://localhost:8086
INFLUX__TOKEN=
INFLUX__ORG=sensical
INFLUX__BUCKET=telemetry
# Each alarm is kept this many days in its own bucket; daily counts per device,
# channel and detector are kept for good in the other. `influx_init` creates both.
INFLUX__ALARMS_BUCKET=alarms
INFLUX__ALARMS_RETENTION_DAYS=30
INFLUX__ALARM_COUNTS_BUCKET=alarm_counts

# --- INFLUXDB Writer settings ---
INFLUXDB_WRITER__HEALTHCHECK_PORT=19090
INFLUXDB_WRITER__CONSUMER__N_MSGS=1000 #Number of messages to be read on each poll to kafka
INFLUXDB_WRITER__CONSUMER__TIMEOUT_MS=1000 #Milliseconds spent waiting in poll if data is not available in the buffer

# --- Decode consumer settings (lite) ---
DECODE_CONSUMER__HEALTHCHECK_PORT=19092
DECODE_CONSUMER__CONSUMER__N_MSGS=100 #Number of messages to be read on each poll to kafka
DECODE_CONSUMER__CONSUMER__TIMEOUT_MS=1000 #Milliseconds spent waiting in poll if data is not available in the buffer

# --- Sink dispatcher settings (full, or `--profile sinks`) ---
SINK_DISPATCHER__HEALTHCHECK_PORT=19093
SINK_DISPATCHER__CONSUMER__N_MSGS=100 #Number of messages to be read on each poll to kafka
SINK_DISPATCHER__CONSUMER__TIMEOUT_MS=1000 #Milliseconds spent waiting in poll if data is not available in the buffer

# --- REGISTRY ROLE settings (Django + DRF) ---
REGISTRY__PORT=8090
# The password here is a SEPARATE copy of POSTGRES_PASSWORD below - nothing
# derives one from the other. Changing POSTGRES_PASSWORD without editing this
# DSN to match leaves Postgres initialized with the new password while
# registry_api still authenticates with the old one, and fails with:
#   FATAL: password authentication failed for user "meshtastic"
REGISTRY__DB_DSN=postgresql://meshtastic:password@postgres:5432/meshtastic_keys
REGISTRY__REDIS_URL=redis://redis:6379/0
# REQUIRES USER ACTION: - generate with
# `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
REGISTRY__SECRET_KEY=
REGISTRY__DEBUG=false
# REQUIRES USER ACTION: append the real hostname when this is behind a domain,
# e.g. localhost,127.0.0.1,api.yourdomain.com - don't replace the defaults,
# they're what the in-container healthcheck connects as.
REGISTRY__ALLOWED_HOSTS=localhost,127.0.0.1
# Set true only behind a TLS-terminating reverse proxy that sets
# X-Forwarded-Proto (enables SECURE_SSL_REDIRECT/HSTS/secure cookies).
REGISTRY__BEHIND_TLS=false
# Comma-separated browser origins allowed cross-origin. Each entry needs a
# scheme and no trailing slash, e.g. https://things.example.com - a bare
# hostname fails Django's system check at startup (corsheaders.E013).
REGISTRY__CORS_ORIGINS=
# REQUIRES USER ACTION: Only needed when the frontend and this API are on different subdomains of
# the same site
# Leave unset when frontend and API share one origin.
REGISTRY__COOKIE_DOMAIN=
REGISTRY__KAFKA_TOPIC="mesh.keys.v1"
REGISTRY__NODE_REJECTIONS_KAFKA_TOPIC="mesh.node_rejections.v1"
REGISTRY__DEVICES_KAFKA_TOPIC="mesh.devices.v1"
REGISTRY__SENSOR_DISCOVERY_KAFKA_TOPIC="mesh.sensor_discovery.v1"
# Samples of unregistered gateways' traffic, matched against meshes with gateway discovery on.
REGISTRY__GATEWAY_CANDIDATES_KAFKA_TOPIC="mesh.gateway_candidates.v1"
# EMQX REST API that sources and sinks are created on, e.g. https://mqtt.example.org:18084/api/v5
# The key needs the administrator role. Without these, creating a source returns 502
# and the sink routes answer 404.
REGISTRY__EMQX_API_URL=
REGISTRY__EMQX_API_KEY=
REGISTRY__EMQX_API_SECRET=
REGISTRY__EMQX_TIMEOUT=10
# Brokers and topic roots a source may not use, comma-separated, with * wildcards.
# Brokers are host or host:port (e.g. *.example.org); roots are literal prefixes
# such as msh/EU_868 (e.g. msh/US*).
REGISTRY__SOURCES_BLOCKED_BROKERS=
REGISTRY__SOURCES_BLOCKED_ROOTS=
# A source can never point at this machine (localhost, 127.0.0.0/8, ::1, 0.0.0.0),
# link-local addresses or bare hostnames such as `emqx`, however they are spelled or
# whatever a name resolves to. Private network addresses (10/8, 172.16/12, 192.168/16,
# 100.64/10, fc00::/7) are refused too unless this is true, e.g. on a self-hosted
# instance bridging a broker on its own LAN.
REGISTRY__SOURCES_ALLOW_PRIVATE_BROKERS=

# --- Terms and data lifecycle (registry_data_lifecycle) ---
# Blank or true asks owners to accept terms (account, mesh, source), as a public
# instance must under GDPR. Set false on an instance you run for yourself, e.g. a
# lite install on a Raspberry Pi: no terms routes (they answer 404), no terms at
# signup or on meshes and sources, no renewals, and DATA_RETENTION_DAYS is ignored.
REGISTRY__TERMS_ENFORCED=
# Blank keeps readings indefinitely. When set (in days), every mesh and source terms
# acceptance lapses after this long unless renewed (account terms never do). A lapse
# stops ingestion (the mesh's gateways, or the source's bridge) and schedules those
# readings for deletion. The terms quote these values, so changing them changes the
# text owners accept. Ignored when REGISTRY__TERMS_ENFORCED=false.
REGISTRY__DATA_RETENTION_DAYS=
# Readings scheduled for deletion (mesh deleted, moved off its source, or terms
# lapsed) stay in place this many days; renewing in the meantime cancels it.
REGISTRY__DATA_DELETION_GRACE_DAYS=30
# How many days before an acceptance lapses its owner is emailed.
REGISTRY__TERMS_RENEWAL_NOTICE_DAYS=30
REGISTRY__DATA_LIFECYCLE_INTERVAL_SECONDS=3600
# Superusers are emailed, at most daily, when the disk holding Docker's data is fuller
# than this percentage (checked on each lifecycle pass). 0 turns it off.
REGISTRY__DISK_ALERT_PERCENT=80
# Optional: create one owner + mesh + gateway on first startup (all
# must be set together)
REGISTRY__SEED_OWNER_NAME=
REGISTRY__SEED_OWNER_EMAIL=
REGISTRY__SEED_CHANNEL_ID=
REGISTRY__SEED_PSK_B64=
REGISTRY__SEED_GATEWAY_DEVICE_ID=

# --- REGISTRY ROLE: email verification + generic email sending ---
REGISTRY__EMAIL_VERIFICATION_TTL_HOURS=24
REGISTRY__PASSWORD_RESET_TTL_HOURS=1
# This API's own externally reachable base URL, e.g. https://api.yourdomain.com
REGISTRY__PUBLIC_BASE_URL=http://localhost:8090
# The frontend app's base URL. Both the verification and password reset
# emails link here rather than at this API directly, so the recipient sees
# a rendered page instead of raw JSON. The frontend reads the token from the
# query string and calls GET /owners/verify-email?token=... itself for
# verification, or POST /owners/reset-password with it as
# `Authorization: Bearer <token>` for a reset.
# REQUIRES USER ACTION for production, e.g. https://app.yourdomain.com
REGISTRY__PUBLIC_FRONTEND_URL=http://localhost:5174
# Prefix of the frontend's authenticated pages, under REGISTRY__PUBLIC_FRONTEND_URL.
# Emails link to pages below it, e.g. {prefix}/meshes/<id>. Set it to / if the
# console is the frontend root.
REGISTRY__FRONTEND_CONSOLE_PATH=/console
# REQUIRES USER ACTION: Set to django.core.mail.backends.smtp.EmailBackend to actually send.
REGISTRY__EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# REQUIRES USER ACTION for production: any real SMTP provider works here; the
# values below are for Scaleway Transactional Email (EU-hosted).
# Leave HOST=mailhog for local dev.
REGISTRY__EMAIL_HOST=mailhog
# Scaleway: smtp.tem.scaleway.com, port 587 (STARTTLS) or 2465 (implicit TLS, needs
# EMAIL_USE_SSL=true/EMAIL_USE_TLS=false instead). Hetzner blocks outbound 25/465.
REGISTRY__EMAIL_PORT=1025
# Scaleway: the Project ID the sending domain lives in
REGISTRY__EMAIL_HOST_USER=
# Scaleway: the API secret key, from an IAM application allowed only to send
REGISTRY__EMAIL_HOST_PASSWORD=
REGISTRY__EMAIL_USE_TLS=false
REGISTRY__EMAIL_USE_SSL=false
# Must be `@` a domain verified in Scaleway's console - sending from an
# unverified domain is rejected at send time, not at startup.
REGISTRY__DEFAULT_FROM_EMAIL=noreply@meshtastic.local

# --- POSTGRES settings ---
# Consumed by the official postgres image's entrypoint on first initialization
# only - keep in sync with REGISTRY__DB_DSN above and READINGS__DB_DSN below.
# Changing POSTGRES_PASSWORD here does nothing to the READINGS__DB_PASSWORD
# role either; that one is a Postgres role Django creates, not something this
# image manages.
POSTGRES_USER=meshtastic
POSTGRES_PASSWORD=password
POSTGRES_DB=meshtastic_keys
# Public age key (age1...) scripts/backup.sh encrypts every dump to. Its private key
# is kept off the server; without this the script refuses to back up. docs/backups.md
BACKUP__AGE_RECIPIENT=

# --- S3 WRITER settings ---
S3_WRITER__BUCKET=meshtastic-telemetry
S3_WRITER__PREFIX=telemetry
S3_WRITER__BATCH_SIZE=1000
# Warning: Each flush rewrites the whole hour partition
S3_WRITER__FLUSH_INTERVAL_S=300
# Local dev target: MinIO.
# REQUIRES USER ACTION for real deployment - replace
# ENDPOINT_URL/ACCESS_KEY/SECRET_KEY with real credentials
S3_WRITER__ENDPOINT_URL=http://minio:9000
S3_WRITER__ACCESS_KEY=meshtastic
S3_WRITER__SECRET_KEY=meshtastic123
# REQUIRED if pointing this at real AWS S3
# (leave ENDPOINT_URL unset in that case), e.g. us-east-1.
# unused if using minio
S3_WRITER__REGION=
S3_WRITER__HEALTHCHECK_PORT=19091

# --- READINGS ROLE settings (Django + DRF) ---
READINGS__PORT=8091
# The "readings" role connects as a read-only Postgres role with column-level
# grants, created by `manage.py provision_read_role` on registry startup. It
# cannot write, and cannot read mesh keys.
# REQUIRES USER ACTION: pick a password and keep both lines in sync.
READINGS__DB_PASSWORD=meshtastic-readonly
READINGS__DB_DSN=postgresql://readings_ro:meshtastic-readonly@postgres:5432/meshtastic_keys
READINGS__DB_MAX_CONNECTIONS=10
READINGS__REDIS_URL=redis://redis:6379/1
# REQUIRED: must be the exact same value as REGISTRY__SECRET_KEY above, not a
# different one - readings_api decodes registry_api's session-cookie rows in
# django_session using Django's SECRET_KEY-keyed signer (no fallback key is
# configured). A different value here fails that decode on every request,
# logging "Session data corrupted" then "Unauthorized" - see docs/deploy.md.
READINGS__SECRET_KEY=
READINGS__DEBUG=false
# Same rule as REGISTRY__ALLOWED_HOSTS above.
READINGS__ALLOWED_HOSTS=localhost,127.0.0.1
# Same as REGISTRY__BEHIND_TLS above.
READINGS__BEHIND_TLS=false
# Same rule as REGISTRY__CORS_ORIGINS above - scheme required, no bare hostnames.
READINGS__CORS_ORIGINS=

# The Parquet archive as readings serves it to operators (full profile only).
# Leave READINGS__ARCHIVE_BUCKET blank on lite, which turns the archive routes off.
# Same bucket and prefix as S3_WRITER__BUCKET/S3_WRITER__PREFIX, but its own
# read-only identity, never the writer's credential.
READINGS__ARCHIVE_BUCKET=meshtastic-telemetry
READINGS__ARCHIVE_PREFIX=telemetry
# Bundled MinIO: the internal endpoint, and what callers outside the stack reach
# (the Caddy site CADDY_S3_ADDRESS in production, the published port in dev).
# External S3: leave both blank for AWS, or set both to the provider's endpoint.
READINGS__ARCHIVE_ENDPOINT_URL=http://minio:9000
READINGS__ARCHIVE_PUBLIC_ENDPOINT_URL=http://localhost:9000
# REQUIRED on AWS (e.g. eu-west-1); unused on MinIO.
READINGS__ARCHIVE_REGION=
# Bundled MinIO: `minio_init` creates this read-only user from these values.
# REQUIRES USER ACTION: pick a real secret.
READINGS__ARCHIVE_ACCESS_KEY=archive-reader
READINGS__ARCHIVE_SECRET_KEY=archive-reader-secret
# How scoped credentials are issued: `minio`, `aws` (needs READINGS__ARCHIVE_ROLE_ARN,
# a role that can read the bucket and that the identity above may assume), or blank
# for a provider without STS, which leaves only listing and single-file downloads.
READINGS__ARCHIVE_STS=minio
READINGS__ARCHIVE_ROLE_ARN=
# Lifetime of issued credentials and download links, 900 to 43200 seconds.
READINGS__ARCHIVE_CREDENTIAL_TTL_S=3600

# --- Exports (full only: they are written to the archive bucket) ---
# The credential readings_export_worker uploads exports with, and nothing else holds.
# On the bundled MinIO, minio_init creates it, allowed to write only under exports/.
# REQUIRES USER ACTION on an external S3: create it with s3:PutObject,
# s3:AbortMultipartUpload and s3:ListMultipartUploadParts on <bucket>/exports/*, and a
# lifecycle rule expiring exports/ after one day.
READINGS__EXPORT_ACCESS_KEY=export-writer
READINGS__EXPORT_SECRET_KEY=export-writer-secret
# Longest range one export may cover, in days.
READINGS__EXPORT_MAX_DAYS=366

# --- REVERSE PROXY (Caddy) settings ---
# REQUIRES USER ACTION for production:
# set to your real domain (e.g. api.yourdomain.com) and Caddy
# obtains/renews a Let's Encrypt certificate automatically. Also set
# REGISTRY__BEHIND_TLS=true/READINGS__BEHIND_TLS=true and
# REGISTRY__PUBLIC_BASE_URL to match
CADDY_SITE_ADDRESS=:80

# --- Public gateway URL ---
# REQUIRES USER ACTION for production: set to the same domain as
# CADDY_SITE_ADDRESS above, with the scheme (e.g. https://api.yourdomain.com).
GATEWAY__PUBLIC_URL=http://localhost

# --- Admin UIs behind the proxy (Flink, Kafka UI, InfluxDB, MinIO) ---
# Credentials need to be added with:
#
#   ./scripts/caddy-admin-user.sh alice
#
# Prompts for the password twice (confirmation), no echo either time. Not an
# env var - written to caddy/credentials/, since Compose's env_file
# interpolation would mangle a hash pasted here.
#
# In production set each to its own hostname.
# Caddy obtains a certificate for each automatically.
# Any subdomain depth works, so grouping them under the API's own name is fine:
#   CADDY_FLINK_ADDRESS=flink.api.yourdomain.com
CADDY_FLINK_ADDRESS=:8181
CADDY_KAFKAUI_ADDRESS=:8182
CADDY_INFLUX_ADDRESS=:8183
CADDY_MINIO_ADDRESS=:8184

# The bundled MinIO's S3 API, for archive credentials and download links. Not an
# admin UI: every request is signed, so there is no basic auth. In production set
# it to its own hostname (e.g. s3.api.yourdomain.com) and point
# READINGS__ARCHIVE_PUBLIC_ENDPOINT_URL at it.
CADDY_S3_ADDRESS=:8185


# Channels derived by postprocessing-job, in the decoded envelope shape
POSTPROCESSING__DERIVED_KAFKA_TOPIC="mesh.telemetry.derived.v1"
PATTERN_DETECTION__ALARMS_TOPIC="mesh.telemetry.alarms.v1"

# --- QUALITY WORKER settings (Celery batch tier) ---
QUALITY_WORKER__REDIS_URL=redis://redis:6379/2
QUALITY_WORKER__REGISTRY_URL=http://registry-api:8090
QUALITY_WORKER__REGISTRY_TIMEOUT=10
# REQUIRES USER ACTION: a superuser API key, so the worker can see every
# owner's devices and run their postprocessing backfills
#   docker compose exec registry_api python manage.py createsuperuser \
#     --email pachuli@example.com --name "Pachuli"
QUALITY_WORKER__REGISTRY_API_KEY=
QUALITY_WORKER__SCAN_INTERVAL_SECONDS=3600
# How often queued postprocessing backfills are picked up.
QUALITY_WORKER__BACKFILL_POLL_SECONDS=60
# Windows each task looks back over.
QUALITY_WORKER__COMPLETENESS_LOOKBACK=-24h
# Alarm when fewer than this fraction of expected readings arrived
QUALITY_WORKER__COMPLETENESS_THRESHOLD=0.8
# The ratio only applies once this many readings are expected in the window, so a
# few lost packets on a slow device do not alarm.
QUALITY_WORKER__RATIO_MIN_EXPECTED=24
# A gap alarms once, when it is first seen, if it is longer than this many reading
# intervals and than QUALITY_WORKER__GAP_MIN_SECONDS. On devices with absence
# detection, gaps (and the time) absence already reported are left out.
QUALITY_WORKER__GAP_INTERVALS_THRESHOLD=6
QUALITY_WORKER__GAP_MIN_SECONDS=1800

# --- DATA QUALITY ---
REGISTRY__QUALITY_CONFIG_KAFKA_TOPIC="mesh.quality_config.v1"
# Compacted: every enabled postprocessing plan per device, for the stream job
REGISTRY__POSTPROCESSING_CONFIG_KAFKA_TOPIC="mesh.postprocessing_config.v1"
# Which sinks (the archive) each device's readings go to. Compacted.
REGISTRY__SINK_CONFIG_KAFKA_TOPIC="mesh.sink_config.v1"
# A device is "not publishing" once it has been silent for this many publish
# intervals
ABSENCE_DETECTION__MISSED_INTERVALS=3
# A device that published after an absence alarm alarms again only once this many
# times the silence limit has passed since that alarm.
ABSENCE_DETECTION__REPEAT_FACTOR=3
# How long a channel must report the same value to count as flat
PATTERN_DETECTION__FLAT_VALUE_HOURS=12
# A condition alarms when it starts, then at most once per this many hours while it
# holds. Those later alarms are stored and summarised, and emailed as a reminder once
# REGISTRY__ALARM_REMINDER_HOURS have passed.
PATTERN_DETECTION__ALARM_REPEAT_HOURS=1
# Per-device alarm window: the first alarm on a device is emailed, later ones
# (any detector or channel) are sent as one summary when the window ends.
# Server-wide default only - an owner overrides it for themselves via
# PUT /owners/me's alarm_email_cooldown_seconds.
REGISTRY__ALARM_EMAIL_COOLDOWN_SECONDS=3600
# While a condition (flat or out of range) holds, its owner is reminded every this many
# hours, so a long silence means the device is fine. 0 emails only when it starts.
REGISTRY__ALARM_REMINDER_HOURS=24
