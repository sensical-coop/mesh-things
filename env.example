# --- Compose file selection ---
# REQUIRES USER ACTION: delete this line.
# Production should run the base file alone.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- Compose profile selection ---
# lite = minimal footprint.
# full = adds the Flink stream, S3/Parquet archive, kafbat-ui.
# REQUIRES USER ACTION for full: set to "full", or leave unset and pass
# --profile.
COMPOSE_PROFILES=lite

# --- App role ---
# "registry" or "readings"
APP_ROLE=registry

# --- MQTT settings ---
# REQUIRES USER ACTION
MQTT_BRIDGE__BROKER=''
MQTT_BRIDGE__PORT=8883
MQTT_BRIDGE__SSL=true
MQTT_BRIDGE__USER=""
MQTT_BRIDGE__PASS=""
# REQUIRES USER ACTION (the MQTT topic filter to subscribe to, e.g. 'msh/#'.)
MQTT_BRIDGE__TOPIC=''
MQTT_BRIDGE__SHARED_SUBS=true
MQTT_BRIDGE__SHARED_GROUP=kafka-bridge
MQTT_BRIDGE__QOS=1
# compose/pipeline.yml sets MQTT_BRIDGE__CLIENT_ID per service. LEAVE IT BLANK
MQTT_BRIDGE__CLIENT_ID=
# How long the broker keeps a member's session after it disconnects (MQTT 5
# session expiry, seconds)
MQTT_BRIDGE__SESSION_EXPIRY=3600
MQTT_BRIDGE__RECONNECT=5
MQTT_BRIDGE__KAFKA_TOPIC="mesh.telemetry.raw.v1"
MQTT_BRIDGE__HEALTH__KAFKA_TOPIC="mesh.telemetry.rawhealth.v1"
MQTT_BRIDGE__HEALTH__TIMEOUT=5
MQTT_BRIDGE__HEALTH__PORT=9090

# --- KAFKA settings ---
# Consumed by the apache/kafka image; don't rename them.
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_BOOTSTRAP_LOCAL=localhost:9092
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1
KAFKA_BROKER_ID=1
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP='CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT'
KAFKA_ADVERTISED_LISTENERS='PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092'
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_JMX_PORT=9997
KAFKA_JMX_OPTS=-Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false -Djava.rmi.server.hostname=kafka0 -Dcom.sun.management.jmxremote.rmi.port=9997
KAFKA_PROCESS_ROLES='broker,controller'
KAFKA_NODE_ID=1
KAFKA_CONTROLLER_QUORUM_VOTERS='1@kafka:29093'
KAFKA_LISTENERS='PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092'
KAFKA_INTER_BROKER_LISTENER_NAME='PLAINTEXT'
KAFKA_CONTROLLER_LISTENER_NAMES='CONTROLLER'
KAFKA_LOG_DIRS='/var/lib/kafka/data'
CLUSTER_ID='MkU3OEVBNTcwNTJENDM2Qk'

# --- PROTO DECODER settings ---
# KAFKA_TOPIC is the shared name for mesh.telemetry.decoded.v1
PROTO_DECODE__KAFKA_TOPIC="mesh.telemetry.decoded.v1"

# --- INFLUXDB settings ---
# REQUIRES USER ACTION: complete the setup wizard at
# http://localhost:8086 and fill *__TOKEN/ORG/BUCKET below
INFLUX__URL=http://influxdb:8086
INFLUX__URL_LOCAL=http://localhost:8086
INFLUX__TOKEN=
INFLUX__ORG=sensical
INFLUX__BUCKET=telemetry

# --- INFLUXDB Writer settings ---
INFLUXDB_WRITER__HEALTHCHECK_PORT=19090
INFLUXDB_WRITER__CONSUMER__N_MSGS=1000 #Number of messages to be read on each poll to kafka
INFLUXDB_WRITER__CONSUMER__TIMEOUT_MS=1000 #Milliseconds spent waiting in poll if data is not available in the buffer

# --- Decode consumer settings (lite) ---
DECODE_CONSUMER__HEALTHCHECK_PORT=19092
DECODE_CONSUMER__CONSUMER__N_MSGS=100 #Number of messages to be read on each poll to kafka
DECODE_CONSUMER__CONSUMER__TIMEOUT_MS=1000 #Milliseconds spent waiting in poll if data is not available in the buffer

# --- REGISTRY ROLE settings (Django + DRF) ---
REGISTRY__PORT=8090
# The password here is a SEPARATE copy of POSTGRES_PASSWORD below - nothing
# derives one from the other. Changing POSTGRES_PASSWORD without editing this
# DSN to match leaves Postgres initialized with the new password while
# registry_api still authenticates with the old one, and fails with:
#   FATAL: password authentication failed for user "meshtastic"
REGISTRY__DB_DSN=postgresql://meshtastic:password@postgres:5432/meshtastic_keys
REGISTRY__REDIS_URL=redis://redis:6379/0
# REQUIRES USER ACTION: - generate with
# `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
REGISTRY__SECRET_KEY=
REGISTRY__DEBUG=false
# REQUIRES USER ACTION: append the real hostname when this is behind a domain,
# e.g. localhost,127.0.0.1,api.yourdomain.com - don't replace the defaults,
# they're what the in-container healthcheck connects as.
REGISTRY__ALLOWED_HOSTS=localhost,127.0.0.1
# Set true only behind a TLS-terminating reverse proxy that sets
# X-Forwarded-Proto (enables SECURE_SSL_REDIRECT/HSTS/secure cookies).
REGISTRY__BEHIND_TLS=false
# Comma-separated browser origins allowed cross-origin. Each entry needs a
# scheme and no trailing slash, e.g. https://things.example.com - a bare
# hostname fails Django's system check at startup (corsheaders.E013).
REGISTRY__CORS_ORIGINS=
REGISTRY__KAFKA_TOPIC="mesh.keys.v1"
REGISTRY__NODE_REJECTIONS_KAFKA_TOPIC="mesh.node_rejections.v1"
REGISTRY__DEVICES_KAFKA_TOPIC="mesh.devices.v1"
REGISTRY__SENSOR_DISCOVERY_KAFKA_TOPIC="mesh.sensor_discovery.v1"
# Optional: create one owner + mesh + gateway on first startup (all
# must be set together)
REGISTRY__SEED_OWNER_NAME=
REGISTRY__SEED_OWNER_EMAIL=
REGISTRY__SEED_CHANNEL_ID=
REGISTRY__SEED_PSK_B64=
REGISTRY__SEED_GATEWAY_DEVICE_ID=

# --- REGISTRY ROLE: email verification + generic email sending ---
REGISTRY__EMAIL_VERIFICATION_TTL_HOURS=24
REGISTRY__PASSWORD_RESET_TTL_HOURS=1
# Must be reachable by when clicking the verification link.
# The public domain, e.g. https://api.yourdomain.com
REGISTRY__PUBLIC_BASE_URL=http://localhost:8090
# The frontend app's base URL. The password reset email links here.
# Since resetting needs a form,
# the frontend reads the token from the query string and calls
# POST /owners/reset-password with it as `Authorization: Bearer <token>`.
# REQUIRES USER ACTION for production, e.g. https://app.yourdomain.com
REGISTRY__PUBLIC_FRONTEND_URL=http://localhost:5174
# REQUIRES USER ACTION: Set to django.core.mail.backends.smtp.EmailBackend to actually send.
REGISTRY__EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# REQUIRES USER ACTION for production: any real SMTP provider works here; the
# values below are for Resend (https://resend.com) - see
# docs/email-resend.md for the full setup (API key, domain verification, DNS).
# Leave HOST=mailhog for local dev.
REGISTRY__EMAIL_HOST=mailhog
# Resend: smtp.resend.com, port 587 (STARTTLS) or 465 (implicit TLS, needs
# EMAIL_USE_SSL=true/EMAIL_USE_TLS=false instead)
REGISTRY__EMAIL_PORT=1025
# Resend: literal string "resend", not your account email
REGISTRY__EMAIL_HOST_USER=
# Resend: the API key, scoped to "Sending access" only
REGISTRY__EMAIL_HOST_PASSWORD=
REGISTRY__EMAIL_USE_TLS=false
REGISTRY__EMAIL_USE_SSL=false
# Must be `@` a domain verified in Resend's dashboard - sending from an
# unverified domain is rejected at send time, not at startup.
REGISTRY__DEFAULT_FROM_EMAIL=noreply@meshtastic.local

# --- POSTGRES settings ---
# Consumed by the official postgres image's entrypoint on first initialization
# only - keep in sync with REGISTRY__DB_DSN above and READINGS__DB_DSN below.
# Changing POSTGRES_PASSWORD here does nothing to the READINGS__DB_PASSWORD
# role either; that one is a Postgres role Django creates, not something this
# image manages.
POSTGRES_USER=meshtastic
POSTGRES_PASSWORD=password
POSTGRES_DB=meshtastic_keys

# --- S3 WRITER settings ---
S3_WRITER__BUCKET=meshtastic-telemetry
S3_WRITER__PREFIX=telemetry
S3_WRITER__BATCH_SIZE=1000
# Warning: Each flush rewrites the whole hour partition
S3_WRITER__FLUSH_INTERVAL_S=300
# Local dev target: MinIO.
# REQUIRES USER ACTION for real deployment - replace
# ENDPOINT_URL/ACCESS_KEY/SECRET_KEY with real credentials
S3_WRITER__ENDPOINT_URL=http://minio:9000
S3_WRITER__ACCESS_KEY=meshtastic
S3_WRITER__SECRET_KEY=meshtastic123
# REQUIRED if pointing this at real AWS S3
# (leave ENDPOINT_URL unset in that case), e.g. us-east-1.
# unused if using minio
S3_WRITER__REGION=
S3_WRITER__HEALTHCHECK_PORT=19091

# --- READINGS ROLE settings (Django + DRF) ---
READINGS__PORT=8091
# The "readings" role connects as a read-only Postgres role with column-level
# grants, created by `manage.py provision_read_role` on registry startup. It
# cannot write, and cannot read mesh keys.
# REQUIRES USER ACTION: pick a password and keep both lines in sync.
READINGS__DB_PASSWORD=meshtastic-readonly
READINGS__DB_DSN=postgresql://readings_ro:meshtastic-readonly@postgres:5432/meshtastic_keys
READINGS__DB_MAX_CONNECTIONS=10
READINGS__REDIS_URL=redis://redis:6379/1
# REQUIRED
READINGS__SECRET_KEY=
READINGS__DEBUG=false
# Same rule as REGISTRY__ALLOWED_HOSTS above.
READINGS__ALLOWED_HOSTS=localhost,127.0.0.1
# Same as REGISTRY__BEHIND_TLS above.
READINGS__BEHIND_TLS=false
# Same rule as REGISTRY__CORS_ORIGINS above - scheme required, no bare hostnames.
READINGS__CORS_ORIGINS=

# --- REVERSE PROXY (Caddy) settings ---
# REQUIRES USER ACTION for production:
# set to your real domain (e.g. api.yourdomain.com) and Caddy
# obtains/renews a Let's Encrypt certificate automatically. Also set
# REGISTRY__BEHIND_TLS=true/READINGS__BEHIND_TLS=true and
# REGISTRY__PUBLIC_BASE_URL to match
CADDY_SITE_ADDRESS=:80

# --- Public gateway URL ---
# REQUIRES USER ACTION for production: set to the same domain as
# CADDY_SITE_ADDRESS above, with the scheme (e.g. https://api.yourdomain.com).
GATEWAY__PUBLIC_URL=http://localhost

# --- Admin UIs behind the proxy (Flink, Kafka UI, InfluxDB, MinIO) ---
# Credentials need to be added with:
#
#   ./scripts/caddy-admin-user.sh alice
#
# Prompts for the password twice (confirmation), no echo either time. Not an
# env var - written to caddy/credentials/, since Compose's env_file
# interpolation would mangle a hash pasted here.
#
# In production set each to its own hostname.
# Caddy obtains a certificate for each automatically.
# Any subdomain depth works, so grouping them under the API's own name is fine:
#   CADDY_FLINK_ADDRESS=flink.api.yourdomain.com
CADDY_FLINK_ADDRESS=:8181
CADDY_KAFKAUI_ADDRESS=:8182
CADDY_INFLUX_ADDRESS=:8183
CADDY_MINIO_ADDRESS=:8184


CALIBRATED__KAFKA_TOPIC="mesh.telemetry.calibrated.v1"
CALIBRATION__KAFKA_TOPIC="mesh.calibration.v1"
PATTERN_DETECTION__INPUT_TOPIC="mesh.telemetry.calibrated.v1"
PATTERN_DETECTION__ALARMS_TOPIC="mesh.telemetry.alarms.v1"

# --- QUALITY WORKER settings (Celery batch tier) ---
QUALITY_WORKER__REDIS_URL=redis://redis:6379/2
QUALITY_WORKER__REGISTRY_URL=http://registry-api:8090
QUALITY_WORKER__REGISTRY_TIMEOUT=10
# REQUIRES USER ACTION: a superuser API key, so the worker can see every
# owner's devices/blueprints
#   docker compose exec registry_api python manage.py createsuperuser \
#     --email pachuli@example.com --name "Pachuli"
QUALITY_WORKER__REGISTRY_API_KEY=
QUALITY_WORKER__SCAN_INTERVAL_SECONDS=3600
# Windows each task looks back over.
QUALITY_WORKER__BLUEPRINT_LOOKBACK=-7d
QUALITY_WORKER__COMPLETENESS_LOOKBACK=-24h
# Alarm when fewer than this fraction of expected readings arrived
QUALITY_WORKER__COMPLETENESS_THRESHOLD=0.8
QUALITY_WORKER__GAP_INTERVALS_THRESHOLD=3

# --- DATA QUALITY ---
REGISTRY__QUALITY_CONFIG_KAFKA_TOPIC="mesh.quality_config.v1"
# A device is "not publishing" once it has been silent for this many publish
# intervals
ABSENCE_DETECTION__MISSED_INTERVALS=3
# How long a channel must stay unchanged to count as flat
PATTERN_DETECTION__FLAT_VALUE_HOURS=3
# Don't re-email an owner about the same (device, channel, detector) more often
# than this.
REGISTRY__ALARM_EMAIL_COOLDOWN_SECONDS=3600
