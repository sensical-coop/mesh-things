# Server monitor (compose/monitor.yml). Copy to monitor.env on the machine that runs it:
#
#   docker compose -f compose/monitor.yml -f compose/monitor.public.yml \
#     --env-file monitor.env --profile monitor up -d --build
#
# See docs/monitoring.md.

# --- Instance under test ---
# REQUIRES USER ACTION: the public base URL, the same one Caddy serves (no trailing slash).
# Beside the stack in dev: http://caddy
MONITOR__API_URL=https://api.yourdomain.com
# REQUIRES USER ACTION: API key of a verified member account kept for the monitor.
# Give it the operator role only if the sink check is used.
MONITOR__API_KEY=
# Shown in alert subjects. Blank uses MONITOR__API_URL.
MONITOR__INSTANCE_NAME=

# --- Test mesh and gateway ---
# REQUIRES USER ACTION: printed by
#   docker compose -f compose/monitor.yml --env-file monitor.env run --rm server_monitor \
#     python -m monitor setup --accept-terms [--sink]
MONITOR__CHANNEL_ID=LongFast
MONITOR__MESH_ID=
MONITOR__PSK_B64=
MONITOR__GATEWAY_NODE_ID=
MONITOR__GATEWAY_UUID=

# --- MQTT: where the probe is published ---
# REQUIRES USER ACTION: the broker the bridge reads (MQTT_BRIDGE__BROKER), with a user
# allowed to publish there.
MONITOR__MQTT_BROKER=
MONITOR__MQTT_PORT=8883
MONITOR__MQTT_SSL=true
MONITOR__MQTT_USER=
MONITOR__MQTT_PASS=
# REQUIRES USER ACTION: a prefix inside MQTT_BRIDGE__TOPIC, e.g. msh/EU_868/2/e when the
# bridge reads msh/#. The probe goes to {prefix}/{channel}/!{gateway hex}.
MONITOR__MQTT_TOPIC_PREFIX=

# --- Optional MQTT sink check (sink_dispatcher). Leave blank to skip it. ---
# Printed by setup --sink. MONITOR__SINK_BROKER is host:port.
MONITOR__SINK_BROKER=
MONITOR__SINK_SSL=true
MONITOR__SINK_USER=
MONITOR__SINK_PASS=
MONITOR__SINK_TOPIC=

# --- Timing ---
MONITOR__INTERVAL_SECONDS=300
MONITOR__HTTP_TIMEOUT=10
# How long a probe may take to reach the readings API, the registry and the sink.
MONITOR__INGEST_TIMEOUT=180
MONITOR__POLL_SECONDS=5

# --- Alerts ---
# REQUIRES USER ACTION: the superusers' addresses, comma-separated. Kept here rather than
# read from the API so alerts still go out when the API is down.
MONITOR__ALERT_EMAILS=
# A check alerts after failing this many times in a row.
MONITOR__FAILURES_BEFORE_ALERT=2
# While anything still fails, a reminder every this many hours. 0 turns reminders off.
MONITOR__REMINDER_HOURS=6
# REQUIRES USER ACTION: SMTP, e.g. the same Scaleway TEM values as REGISTRY__EMAIL_*.
MONITOR__EMAIL_HOST=
MONITOR__EMAIL_PORT=587
MONITOR__EMAIL_HOST_USER=
MONITOR__EMAIL_HOST_PASSWORD=
MONITOR__EMAIL_USE_TLS=true
MONITOR__EMAIL_USE_SSL=false
MONITOR__EMAIL_FROM=monitor@yourdomain.com

# --- Status API ---
# Host side of the published port. Loopback only, unless compose/monitor.public.yml is
# added, which publishes it on every interface for Uptime Robot.
MONITOR__PORT=8095
# Enables /run and /run/{check}, which publish a probe on request. Blank: those routes
# answer 404. Generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
MONITOR__RUN_TOKEN=
# On-demand runs within this many seconds of the last probe return its results instead.
MONITOR__RUN_MIN_INTERVAL_SECONDS=30
