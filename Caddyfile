# The readings role owns /readings/*; the registry role serves everything else.
{$CADDY_SITE_ADDRESS::80} {
	handle / {
		header Content-Type application/json
		respond `{
  "name": "Mesh Things",
  "description": "Owners, meshes, devices, measurements, and readings",
  "schema": "/schema",
  "docs": "/docs",
  "health": "/health",
  "metrics": "/metrics",
  "readings": "/readings"
}` 200
	}

	handle /readings/* {
		reverse_proxy readings-api:8091
	}

	handle {
		reverse_proxy registry-api:8090
	}
}

# Admin UIs
# Kafka UI, the Flink dashboard, InfluxDB and the MinIO console with their own addresses
# because they can't be proxied
(admin_ui) {
	basic_auth bcrypt {
		# Credentials come from files in ./caddy/credentials/
		# Add a user:  ./scripts/caddy-admin-user.sh <name>
		import /etc/caddy/credentials/*.txt
	}
}

{$CADDY_FLINK_ADDRESS::8181} {
	import admin_ui
	reverse_proxy jobmanager:8081
}

{$CADDY_KAFKAUI_ADDRESS::8182} {
	import admin_ui
	reverse_proxy kafbat-ui:8080
}

{$CADDY_INFLUX_ADDRESS::8183} {
	# InfluxDB's own UI logs in via `Authorization: Basic` on /api/v2/signin -
	# the same header basic_auth above checks. Gating /api/* here too makes
	# Caddy re-validate InfluxDB's admin credentials against ITS OWN user
	# store and reject them, since they're not a Caddy admin_ui credential.
	# Exempting /api/* leaves it to InfluxDB's own (real) authentication.
	@ui not path /api/*
	basic_auth @ui bcrypt {
		import /etc/caddy/credentials/*.txt
	}
	reverse_proxy influxdb:8086
}

{$CADDY_MINIO_ADDRESS::8184} {
	import admin_ui
	reverse_proxy minio:9001
}
